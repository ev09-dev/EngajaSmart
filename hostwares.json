{
  "name": "engajasmart",
  "framework": "nextjs",
  "build": {
    "command": "pnpm install && pnpm build",
    "outputDirectory": ".next/standalone"
  },
  "start": {
    "command": "node server.js",
    "port": 3000
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "HOSTNAME": "0.0.0.0"
  },
  "healthCheck": {
    "path": "/api/health",
    "interval": "30s",
    "timeout": "10s",
    "retries": 3
  },
  "features": {
    "zeroDowntime": true,
    "autoSSL": true,
    "cdn": true
  },
  "scaling": {
    "minInstances": 1,
    "maxInstances": 10,
    "targetMemoryPercent": 70,
    "targetCPUPercent": 70
  }
}